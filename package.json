{
  "name": "aiotsphere-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=@aiotsphere/web run dev",
    "dev:admin": "npm --workspace=@aiotsphere/admin run dev",
    "build": "npm run build:web && npm run build:admin",
    "build:web": "npm --workspace=@aiotsphere/web run build",
    "build:admin": "npm --workspace=@aiotsphere/admin run build",
    "lint": "npm run lint:web && npm run lint:admin",
    "lint:web": "npm --workspace=@aiotsphere/web run lint",
    "lint:admin": "npm --workspace=@aiotsphere/admin run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^13.5.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^13.2.3",
    "prettier": "^3.5.3",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
