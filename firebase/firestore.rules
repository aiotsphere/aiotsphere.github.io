rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'administrator';
    }

    function isStaff() {
      return isAuthenticated() && (getUserRole() in ['staff', 'administrator']);
    }

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read: if isAuthenticated() && request.auth.uid == userId || isStaff();
      allow update: if isAuthenticated() && request.auth.uid == userId || isStaff();
      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /activity_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /registrations/{registrationId} {
      allow create: if isAuthenticated();
      allow read: if isStaff() || resource.data.userId == request.auth.uid;
      allow update: if isStaff() || resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow create: if isStaff();
      allow read: if isStaff() || resource.data.userId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isStaff();
    }

    match /payments/{paymentId} {
      allow create: if isAuthenticated();
      allow read: if isStaff() || resource.data.userId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
